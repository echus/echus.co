---
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import "@fontsource/jetbrains-mono/800.css";
import "../styles/global.css";
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import backgroundDark from "../assets/background-dark.png";
import backgroundLight from "../assets/background-light.png";

type Project = {
  slug: string;
  name: string;
  aka?: string;
  where: string;
  when: string;
  body: string;
  stack?: string;
  links: { label: string; href: string }[];
};

const title = "Varvara Efremova | Software developer person";
const description = "I build software for scientists and researchers (and also for fun).";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Wallpapers from https://wallpaper.echus.co/?seed=488892&device=custom&w=2560&h=1440&colour=rhodamine&mode=dark&accents=3&glitch=1
// and the same address with mode=light. The >>>>> arrows behind the intro (x 1112-1189, y 537-566)
// are removed by hand: covered with the empty patch just above them.
const [wallpaperDark, wallpaperLight] = await Promise.all(
  [backgroundDark, backgroundLight].map((src) => getImage({ src, format: "webp" })),
);

// Screenshots from scripts/screenshots.js: <slug>.png, or <slug>-dark.png and <slug>-light.png
const images = import.meta.glob<ImageMetadata>("../assets/projects/*.png", { eager: true, import: "default" });
const shotsOf = (slug: string) =>
  ["", "dark", "light"].flatMap((theme) => {
    const src = images[`../assets/projects/${slug}${theme && `-${theme}`}.png`];
    return src ? [{ src, theme }] : [];
  });

const projects: Project[] = [
  {
    slug: "dumb-tasks",
    name: "Dumb Tasks",
    where: "Personal",
    when: "2026",
    body: "A really simple local-first task list, with optional sync via WebDAV or Google Drive.",
    stack: "typescript svelte indexeddb",
    links: [
      { label: "dumbtasks.app", href: "https://dumbtasks.app" },
      { label: "source", href: "https://github.com/echus/dumb-tasks" },
    ],
  },
  {
    slug: "wallpaper",
    name: "Wallpaper Generator",
    where: "Personal",
    when: "2026",
    body: "A minimal cyberpunk wallpaper generator.",
    stack: "javascript canvas",
    links: [
      { label: "wallpaper.echus.co", href: "https://wallpaper.echus.co" },
      { label: "source", href: "https://github.com/echus/cyberpunk-wallpaper-generator" },
    ],
  },
  {
    slug: "datastudio",
    name: "DataStudio",
    where: "UNSW Sydney",
    when: "now",
    body: "A platform for running, saving and sharing reproducible scientific data analyses.",
    stack: "python streamlit docker aws",
    links: [{ label: "datastudioapp.com", href: "https://datastudioapp.com" }],
  },
  {
    slug: "bindfit",
    name: "Bindfit",
    where: "UNSW Sydney",
    when: "2016",
    body: "Binding constant fitting for NMR and UV-Vis titration data. Serving the supramolecular chemistry community since 2016 with 20,000 analysis sessions a year.",
    stack: "python django postgresql ember.js",
    links: [
      { label: "bindfit app", href: "https://app.supramolecular.org/bindfit" },
      { label: "supramolecular.org", href: "https://supramolecular.org" },
      { label: "source", href: "https://github.com/echus/supramolecular-apps" },
    ],
  },
  {
    slug: "makerspace",
    name: "Canberra Makerspace",
    aka: "Make Hack Void",
    where: "President",
    when: "2021 – now",
    body: "A community space for makers, hackers and artists to hang out and share skills and knowledge. We provide tools and a welcoming place to work on anything from electronics and radio to sculpting and welding.",
    links: [{ label: "canberramaker.space", href: "https://canberramaker.space" }],
  },
];
---

<!doctype html>
<html
  lang="en"
  style={`--wallpaper-dark: url(${wallpaperDark.src}); --wallpaper-light: url(${wallpaperLight.src})`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <script is:inline>
      // Apply a saved theme before first paint so the page doesn't flash
      try {
        const theme = localStorage.getItem("theme");
        if (theme) document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <div class="wrap">
      <header class="top">
        <span class="logo"><span class="prompt">&gt;_</span> echus</span>
        <nav>
          <a href="#work">work</a>
          <a href="https://github.com/echus">github</a>
          <a href="#contact">contact</a>
          <button id="theme-toggle" type="button" aria-label="Toggle dark mode"></button>
        </nav>
      </header>

      <main>
        <section class="hero">
          <p class="cmd"><span class="prompt">~ $</span> whoami</p>
          <h1>Hi, I'm V.<span class="cursor"></span></h1>
          <p>{description}</p>
        </section>

        <section id="work">
          <p class="cmd"><span class="prompt">~ $</span> ls -l projects/</p>
          <p class="total">total {projects.length}</p>

          {
            projects.map((p) => (
              <article class="proj">
                <div class="bar">
                  <span>
                    <b>{p.slug}</b> · {p.where}
                  </span>
                  <span>{p.when}</span>
                </div>
                <div class="body">
                  <div class="text">
                    <h2><a href={p.links[0].href}>{p.name}</a></h2>
                    {p.aka && <p class="aka">aka {p.aka}</p>}
                    <p>{p.body}</p>
                    {p.stack && <p class="stack">{p.stack}</p>}
                    <div class="links">
                      {p.links.map((l) => (
                        <a href={l.href}>{l.label}</a>
                      ))}
                    </div>
                  </div>
                  <div class="shot">
                    {shotsOf(p.slug).map(({ src, theme }) => (
                      <Image
                        src={src}
                        class={theme || undefined}
                        alt={`${p.name} screenshot`}
                        widths={[267, 534]}
                        sizes="(max-width: 640px) 100vw, 267px"
                      />
                    ))}
                  </div>
                </div>
              </article>
            ))
          }
        </section>
      </main>

      <footer id="contact">
        <p class="cmd"><span class="prompt">~ $</span> contact</p>
        <div class="links">
          <a href="mailto:varvara@echus.co">varvara@echus.co</a>
          <a href="https://github.com/echus">github.com/echus</a>
          <a href="https://ko-fi.com/echus">ko-fi.com/echus</a>
        </div>
      </footer>
    </div>

    <script>
      const root = document.documentElement;
      const toggle = document.getElementById("theme-toggle")!;
      const current = () => root.dataset.theme ?? "dark";
      const other = () => (current() === "dark" ? "light" : "dark");

      // The label names the theme a click switches to
      const render = () => {
        toggle.textContent = `[${other()}]`;
        toggle.setAttribute("aria-pressed", String(current() === "dark"));
      };

      toggle.addEventListener("click", () => {
        const next = other();
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
        render();
      });
      render();
    </script>
  </body>
</html>
